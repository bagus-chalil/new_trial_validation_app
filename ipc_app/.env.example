APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# QAC Super Apps portal ("Kembali ke Portal" link on the login page). Leave empty
# to use https://<same host> on the default port (production layout).
PORTAL_URL=http://localhost:9003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Unique per app+environment (browsers share cookies across ports on one host).
# On servers CI adds qac_<app>_<environment>_session to .env if it is missing
# (or prints a warning with the line to add by hand when .env is not writable).
# SESSION_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VISION_SERVICE_URL=http://100.100.160.31:8000
VISION_SERVICE_TIMEOUT=90
VISION_LLM_TIMEOUT=150
VISION_SERVICE_CONNECT_TIMEOUT=5
# Startup AI cross-check ("Baca AI" next to Label Bulk / IM / Primary Coding photos). Advisory only.
# Keep false until the Vision Service + Ollama GPU server are reachable from this server.
VISION_STARTUP_AI_ENABLED=false
# Extra advisory LLM read of the tube crimp EXP. Empty value = off. Must exist in the Vision Service field types.
VISION_TUBE_LLM_FIELD_TYPE=tube_exp_llm
# Primary Coding read: coding_formula (batch + EXP by SKU formula, both tube photos in one call) or
# coding_print (old per-photo path, rollback). coding_formula needs the Vision Service deployed 2026-11-19 or later.
VISION_STARTUP_CODING_FIELD_TYPE=coding_formula
# With coding_formula: also run the old tube reads (tube_exp_date + VISION_TUBE_LLM_FIELD_TYPE) for comparison.
VISION_STARTUP_LEGACY_TUBE_READS=false
# With coding_formula: a tube Primary Coding result is always REVIEW (old policy). false = judge tube like non-tube.
VISION_STARTUP_TUBE_FORCE_REVIEW=true
# Queue visibility timeout (database driver). Must stay above the longest job timeout (200s vision, 300s import).
# Do not lower it in .env; the default in config/queue.php is already 360.
DB_QUEUE_RETRY_AFTER=360

# new_trial_validation_app server-to-server API (Status Trial per Produk). Token = INTERNAL_API_TOKEN there.
# Lokal: port dev app trial. Server: vhost loopback http://127.0.0.1:9019 (prod) / :9018 (dev), lihat deploy/README.md section 13.
TRIAL_API_URL=http://127.0.0.1:9001
TRIAL_API_TOKEN=
# Trial berjalan tanpa gerakan selama sekian hari ditandai "perlu perhatian".
TRIAL_STALE_DAYS=90
