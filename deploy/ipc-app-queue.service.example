# Queue worker for ipc_app (Excel import of Master Produk / Master Line runs as a queued job).
# Without this running, imports sit at "Menunggu giliran di antrian..." forever.
# See deploy/README.md section 11.
#
# Production:  sudo cp ipc-app-queue.service.example /etc/systemd/system/ipc-app-queue.service
# Development: copy again as ipc-app-queue-development.service and change WorkingDirectory
#              to /var/www/trial_validation_app-development/ipc_app
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ipc-app-queue
#   systemctl status ipc-app-queue
#   journalctl -u ipc-app-queue -f

[Unit]
Description=ipc_app queue worker (production)
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/trial_validation_app/ipc_app
# --timeout must stay below DB_QUEUE_RETRY_AFTER (config/queue.php default 360s).
# --max-time recycles the process hourly; CI's `php artisan queue:restart` also makes it
# exit after each deploy, and systemd starts it again on the new code.
ExecStart=/usr/bin/php artisan queue:work database --queue=default --tries=1 --timeout=300 --sleep=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
