# Contoh vhost Nginx untuk Portal (static chooser: pilih new_trial_validation_app
# atau ipc_app). Tidak butuh PHP-FPM sama sekali — cuma static HTML/JS.
# Copy ke /etc/nginx/sites-available/trial-validation-portal.conf, lalu:
#   sudo ln -s /etc/nginx/sites-available/trial-validation-portal.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Self-signed cert (lihat deploy/nginx-legacy.conf.example untuk penjelasan
# lengkap kenapa self-signed, bukan Let's Encrypt — server ini diakses lewat
# IP, bukan domain):
#   sudo openssl req -x509 -nodes -days 825 -newkey rsa:2048 \
#     -keyout /etc/nginx/ssl/trial-validation-portal.key \
#     -out /etc/nginx/ssl/trial-validation-portal.crt \
#     -subj "/CN=100.100.160.23"
#
# PENTING: portal/config.js di server (bukan yang di git — lihat deploy/README.md
# bagian "Routing semua aplikasi") harus di-edit manual supaya trialValidationUrl
# & ipcUrl mengarah ke URL production new_trial_validation_app/ipc_app yang
# sebenarnya, bukan localhost. File ini di-exclude dari rsync (lihat
# .gitlab-ci.yml) supaya edit manual itu tidak pernah ketimpa deploy.

server {
    listen 9000;
    server_name _; # ganti dengan domain/IP on-premise yang sebenarnya
    return 301 https://$host:9001$request_uri;
}

server {
    listen 9001 ssl;
    server_name _; # ganti dengan domain/IP on-premise yang sebenarnya

    ssl_certificate     /etc/nginx/ssl/trial-validation-portal.crt;
    ssl_certificate_key /etc/nginx/ssl/trial-validation-portal.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /var/www/trial_validation_app/portal; # portal ikut ter-rsync lewat deploy legacy, lihat README
    index index.html;

    access_log /var/log/nginx/trial-validation-portal.access.log;
    error_log  /var/log/nginx/trial-validation-portal.error.log;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;

    location / {
        try_files $uri $uri/ =404;
    }
}
