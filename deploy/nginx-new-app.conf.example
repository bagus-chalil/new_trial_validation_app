# Contoh vhost Nginx untuk new_trial_validation_app/ (Laravel + Inertia) —
# environment PRODUCTION. Beda dari legacy: root harus ke folder public/
# MILIK APLIKASI INI (new_trial_validation_app/public), bukan root repo —
# ini pola standar Laravel.
#
# CATATAN PENTING: nginx cuma serve HTTP-nya. Kode sumber aplikasi ini sudah
# ikut ter-rsync lewat deploy legacy (karena rsync nyalin seluruh monorepo),
# tapi Laravel-nya SENDIRI belum di-setup — itu belum masuk CI/CD (lihat
# "Scope saat ini" di deploy/README.md). Sebelum vhost ini bisa dipakai,
# jalankan manual sekali di server:
#
#   cd /var/www/trial_validation_app/new_trial_validation_app
#   composer install --no-dev --optimize-autoloader
#   cp .env.example .env
#   sudo nano .env   # isi APP_URL=https://100.100.160.23:9011
#                     #      OLD_APP_URL=https://100.100.160.23 (legacy production)
#                     #      DB_* (kredensial DB production, JANGAN default lokal)
#   php artisan key:generate
#   npm ci && npm run build
#   php artisan migrate --force
#   php artisan storage:link
#   sudo chown -R www-data:www-data storage bootstrap/cache
#
# Copy vhost ke /etc/nginx/sites-available/trial-validation-new-app.conf, lalu:
#   sudo ln -s /etc/nginx/sites-available/trial-validation-new-app.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Self-signed cert:
#   sudo openssl req -x509 -nodes -days 825 -newkey rsa:2048 \
#     -keyout /etc/nginx/ssl/trial-validation-new-app.key \
#     -out /etc/nginx/ssl/trial-validation-new-app.crt \
#     -subj "/CN=100.100.160.23"
#
# JUGA: config/sso.php di legacy production (/var/www/trial_validation_app/config/sso.php,
# excluded dari rsync) harus di-set 'new_app_url' => 'https://100.100.160.23:9011'
# supaya tombol "Buka Aplikasi Baru" di legacy production nyambung ke sini.

server {
    listen 9010;
    server_name _; # ganti dengan domain/IP on-premise yang sebenarnya
    return 301 https://$host:9011$request_uri;
}

server {
    listen 9011 ssl;
    server_name _; # ganti dengan domain/IP on-premise yang sebenarnya

    ssl_certificate     /etc/nginx/ssl/trial-validation-new-app.crt;
    ssl_certificate_key /etc/nginx/ssl/trial-validation-new-app.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /var/www/trial_validation_app/new_trial_validation_app/public;
    index index.php;

    access_log /var/log/nginx/trial-validation-new-app.access.log;
    error_log  /var/log/nginx/trial-validation-new-app.error.log;

    client_max_body_size 20m;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock; # sesuaikan versi PHP
        # Cookie session+XSRF-TOKEN Laravel/Fortify/Inertia lebih besar dari
        # PHP session biasa (legacy) — default nginx (4-8k) bisa kena
        # "upstream sent too big header" pas response set banyak/besar
        # cookie sekaligus (mis. GET /dashboard). Naikkan buffer-nya.
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
