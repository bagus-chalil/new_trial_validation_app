# Contoh vhost Nginx untuk Portal — environment DEVELOPMENT.
# Sama seperti nginx-portal.conf.example, tapi root-nya ke deploy path
# development (/var/www/trial_validation_app-development), bukan production.
#
# Copy ke /etc/nginx/sites-available/trial-validation-portal-development.conf, lalu:
#   sudo ln -s /etc/nginx/sites-available/trial-validation-portal-development.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Cert: sebaiknya pakai cert dari CA internal (deploy/README.md bagian 10),
# wajib supaya Portal bisa diinstal sebagai PWA. Fallback self-signed (terpisah dari yang production, nama file beda):
#   sudo openssl req -x509 -nodes -days 825 -newkey rsa:2048 \
#     -keyout /etc/nginx/ssl/trial-validation-portal-development.key \
#     -out /etc/nginx/ssl/trial-validation-portal-development.crt \
#     -subj "/CN=100.100.160.23"
#
# PENTING: /var/www/trial_validation_app-development/portal/config.js harus
# di-edit manual mengarah ke URL DEVELOPMENT new_trial_validation_app/ipc_app
# (:9013 dan :9023), bukan URL production. File ini di-exclude dari rsync,
# lihat deploy/README.md bagian "Routing semua aplikasi".
#
# Portal development sengaja dipasang di port default-nya sendiri (8080/8443,
# sama seperti legacy development yang lama) supaya IP polos di lingkungan
# development juga langsung buka Portal — Legacy development pindah ke
# :9002/:9003, lihat deploy/nginx-development.conf.example.

server {
    listen 8080;
    server_name _;
    return 301 https://$host:8443$request_uri;
}

server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/trial-validation-portal-development.crt;
    ssl_certificate_key /etc/nginx/ssl/trial-validation-portal-development.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /var/www/trial_validation_app-development/portal;
    index index.html;

    access_log /var/log/nginx/trial-validation-portal-development.access.log;
    error_log  /var/log/nginx/trial-validation-portal-development.error.log;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;

    # PWA (lihat deploy/README.md bagian 10): browser harus selalu cek versi
    # terbaru service worker & manifest, jangan pernah di-cache lama.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff;
        try_files $uri =404;
    }

    # Root CA publik (disalin CI dari /etc/nginx/ssl/qac/ca/), diunduh user
    # lewat portal/sertifikat.html. MIME ini supaya Android/iOS langsung
    # mengenalinya sebagai sertifikat CA.
    location = /qac-root-ca.crt {
        default_type application/x-x509-ca-cert;
        add_header Content-Disposition 'attachment; filename="qac-root-ca.crt"';
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
