# Contoh vhost Nginx untuk ipc_app/ (Laravel + Inertia, IPC) — environment
# PRODUCTION. App terpisah total dari legacy/new_trial_validation_app (DB
# sendiri "ipc_system", tidak ada SSO), tapi root filesystem-nya numpang
# ikut ter-rsync lewat deploy legacy (rsync nyalin seluruh monorepo).
#
# Setup Laravel manual (sekali, belum masuk CI/CD — lihat "Scope saat ini"
# di deploy/README.md):
#   cd /var/www/trial_validation_app/ipc_app
#   composer install --no-dev --optimize-autoloader
#   cp .env.example .env
#   sudo nano .env   # APP_URL=https://100.100.160.23:9021
#                     # DB_DATABASE=ipc_system + kredensial DB production
#   php artisan key:generate
#   npm ci && npm run build
#   php artisan migrate --force
#   php artisan storage:link
#   sudo chown -R www-data:www-data storage bootstrap/cache
#
# Copy vhost ke /etc/nginx/sites-available/trial-validation-ipc-app.conf, lalu:
#   sudo ln -s /etc/nginx/sites-available/trial-validation-ipc-app.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Self-signed cert:
#   sudo openssl req -x509 -nodes -days 825 -newkey rsa:2048 \
#     -keyout /etc/nginx/ssl/trial-validation-ipc-app.key \
#     -out /etc/nginx/ssl/trial-validation-ipc-app.crt \
#     -subj "/CN=100.100.160.23"

server {
    listen 9020;
    server_name _; # ganti dengan domain/IP on-premise yang sebenarnya
    return 301 https://$host:9021$request_uri;
}

server {
    listen 9021 ssl;
    server_name _; # ganti dengan domain/IP on-premise yang sebenarnya

    ssl_certificate     /etc/nginx/ssl/trial-validation-ipc-app.crt;
    ssl_certificate_key /etc/nginx/ssl/trial-validation-ipc-app.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /var/www/trial_validation_app/ipc_app/public;
    index index.php;

    access_log /var/log/nginx/trial-validation-ipc-app.access.log;
    error_log  /var/log/nginx/trial-validation-ipc-app.error.log;

    client_max_body_size 20m;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock; # sesuaikan versi PHP
        # Cookie session+XSRF-TOKEN Laravel/Fortify/Inertia lebih besar dari
        # PHP session biasa (legacy) — default nginx (4-8k) bisa kena
        # "upstream sent too big header" pas response set banyak/besar
        # cookie sekaligus (mis. GET /dashboard). Naikkan buffer-nya.
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
